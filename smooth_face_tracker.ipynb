import cv2
import face_recognition
import serial
import time
import pickle

# Load teacher encoding
with open("teacher_face.pkl", "rb") as f:
    teacher_encoding = pickle.load(f)

# Connect to Arduino
arduino = serial.Serial("COM11", 9600)
time.sleep(2)

cap = cv2.VideoCapture(1)

servo_angle = 90
target_angle = 90
current_angle = 90
searching_direction = 1  # 1 = right, -1 = left

def clamp(val, min_val=0, max_val=180):
    return max(min_val, min(val, max_val))

def smooth_move(current, target, smoothing=0.15):
    return current + (target - current) * smoothing

last_seen = time.time()

while True:
    ret, frame = cap.read()
    if not ret:
        continue

    frame = cv2.flip(frame, 1)
    height, width = frame.shape[:2]
    center_x = width // 2
    tolerance = 40

    rgb = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)
    boxes = face_recognition.face_locations(rgb)
    encodings = face_recognition.face_encodings(rgb, boxes)

    found = False

    for (box, encoding) in zip(boxes, encodings):
        match = face_recognition.compare_faces([teacher_encoding], encoding, tolerance=0.5)
        if match[0]:
            found = True
            last_seen = time.time()

            (top, right, bottom, left) = box
            face_center = (left + right) // 2

            cv2.rectangle(frame, (left, top), (right, bottom), (0, 255, 0), 2)
            cv2.putText(frame, "Teacher", (left, top - 10), cv2.FONT_HERSHEY_SIMPLEX, 0.6, (0, 255, 0), 2)

            if face_center < center_x - tolerance:
                target_angle -= 2
            elif face_center > center_x + tolerance:
                target_angle += 2

            target_angle = clamp(target_angle)
            break

    if not found and (time.time() - last_seen > 1.0):
        target_angle += searching_direction
        if target_angle >= 180 or target_angle <= 0:
            searching_direction *= -1
            target_angle = clamp(target_angle)
        time.sleep(0.01)

    new_angle = smooth_move(current_angle, target_angle, smoothing=0.15)
    new_angle = clamp(int(new_angle))

    if abs(new_angle - current_angle) >= 1:
        current_angle = new_angle
        arduino.write(f"{current_angle}\n".encode())
        time.sleep(0.01)

    cv2.line(frame, (center_x, 0), (center_x, height), (255, 0, 0), 2)
    cv2.imshow("Smart Face Tracker", frame)

    if cv2.waitKey(1) == ord('q'):
        break

cap.release()
cv2.destroyAllWindows()
